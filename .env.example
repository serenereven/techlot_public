DJANGO_SECRET_KEY=your-secret-key-here-generate-with-python-secrets-token-urlsafe-50
DJANGO_SETTINGS_MODULE=techlot.settings
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://localhost
DJANGO_DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=techlot_db
DB_USER=techlot_user
DB_PASSWORD=change-this-to-strong-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Bitrix24 (получите в настройках Bitrix24)
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/webhook-code/
BITRIX_ASSIGNED_ID=1
BITRIX_CATALOG_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/catalog-webhook/
BITRIX_INCOMING_TOKEN=generate-with-python-secrets-token-hex-32
BITRIX_CATALOG_SECRET=generate-with-python-secrets-token-hex-32
BITRIX_WEBHOOK_HANDLER_URL=https://yourdomain.com/webhooks/bitrix/catalog/
# BITRIX_OLD_HANDLER_URL=https://old-domain.com/webhooks/bitrix/catalog/

# Timeouts (seconds)
BITRIX_TIMEOUT=15
BITRIX_DEDUP_TTL=10